# ==============================================================================
# Backend Configuration
# ==============================================================================
PROJECT_NAME="IrtrixAI Coding Assistant"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="irtrixai_db"
POSTGRES_USER="irtrixai"
POSTGRES_PASSWORD="irtrixai_dev_password"
DATABASE_URL="postgresql+asyncpg://irtrixai:irtrixai_dev_password@localhost:5432/irtrixai_db"
TEST_DATABASE_URL="postgresql+asyncpg://irtrixai:irtrixai_dev_password@localhost:5432/irtrixai_test"

# ==============================================================================
# LLM Providers & Gateway Configuration
# ==============================================================================
PRIMARY_LLM_PROVIDER="gemini"
PRIMARY_LLM_MODEL="gemini-2.5-flash"

# Fallback to high-speed cloud Groq
FALLBACK_LLM_PROVIDER="groq"
FALLBACK_LLM_MODEL="openai/gpt-oss-120b"

# Provider Specific Credentials & Settings
GEMINI_API_KEY="your_actual_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

GROQ_API_KEY="your_actual_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5vl:7b"

LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_THINKING_LEVEL="low"

# ==============================================================================
# Execution & Workspace Boundaries
# ==============================================================================
WORKSPACE_BASE_PATH="./workspaces"
MAX_WORKSPACE_DEPTH=5
MAX_READ_FILE_BYTES=1048576
MAX_WRITE_FILE_BYTES=1048576
MAX_TOOL_OUTPUT_BYTES=51200
MAX_SEARCH_RESULTS=100
MAX_SEARCH_FILE_SIZE=524288
MAX_PATCH_SIZE=262144
COMMAND_TIMEOUT_SECONDS=30

# ==============================================================================
# Docker Sandbox Execution Settings
# ==============================================================================
DOCKER_SANDBOX_IMAGE="irtrixai-sandbox:latest"
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT="512m"
SANDBOX_CPU_LIMIT="1.0"
SANDBOX_PIDS_LIMIT=64
SANDBOX_CONTAINER_USER="1000:1000"
SANDBOX_TMPFS_SIZE="64m"

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_URL="http://localhost:8000"

# ==============================================================================
# Ollama Bounded Context Limits (Phase 13A-8)
# ==============================================================================
OLLAMA_MAX_CONTEXT_FILES=4
OLLAMA_MAX_FILE_CONTEXT_BYTES=4000
OLLAMA_MAX_TOTAL_CONTEXT_BYTES=12000
OLLAMA_MAX_EXCERPT_LINES=60
OLLAMA_MAX_WORKSPACE_SUMMARY_BYTES=12000
OLLAMA_MAX_OUTPUT_TOKENS=4096

# ==============================================================================
# LangSmith Observability (Phase 13A-8: Opt-in, default false)
# ==============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="irtrixai"
LANGSMITH_ENDPOINT=""