# ==============================================================================
# Backend Configuration
# ==============================================================================
PROJECT_NAME="IrtrixAI Coding Assistant"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="irtrixai_db"
POSTGRES_USER="irtrixai"
POSTGRES_PASSWORD="irtrixai_dev_password"
DATABASE_URL="postgresql+asyncpg://irtrixai:irtrixai_dev_password@localhost:5432/irtrixai_db"

# LLM Providers (Selected during later agent tasks)
PRIMARY_LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"

# Execution & Workspace Boundaries
WORKSPACE_BASE_PATH="/tmp/irtrixai_workspaces"
DOCKER_SANDBOX_IMAGE="irtrixai-sandbox:latest"
COMMAND_TIMEOUT_SECONDS=30
MAX_OUTPUT_BYTES=50000

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_URL="http://localhost:8000"